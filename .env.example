# Optional — Google sign-in + Firestore cloud sync.
# Without these the app runs fully offline (localStorage only).
# Create a Firebase project → Web app → copy the config values here, then save as .env.local
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — who runs this deployment (src/utils/siteOwner.js). Unset, a build names nobody:
# no demo account, no contact address, a made-up dev account.
#
# Emails (comma-separated) whose account always gets back its résumés marked "Keep as my original".
# Unset or empty = nobody.
# VITE_DEMO_ACCOUNTS=you@example.com
#
# The address the Terms and Privacy pages give for questions. Unset, they say to contact the
# people who run the site — set it before you deploy publicly.
# VITE_CONTACT_EMAIL=you@example.com
#
# The account the dev server (yarn dev) signs in as when Firebase is not configured or its Google
# popup fails. Defaults: dev_user / dev@example.com / Dev User. Name one of VITE_DEMO_ACCOUNTS
# here to try the demo-account behaviour locally.
# VITE_DEV_USER_UID=dev_user
# VITE_DEV_USER_EMAIL=dev@example.com
# VITE_DEV_USER_NAME=Dev User
