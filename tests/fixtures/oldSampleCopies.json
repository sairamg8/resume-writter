  "personal": {"email": "jordan.rivera@example.com", "github": "github.com/jordan-rivera-sample", "hiddenFields": [], "linkedin": "linkedin.com/in/jordan-rivera-sample", "location": "Austin, TX", "name": "Jordan Rivera", "phone": "+1 555 0142", "photo": null, "summary": "<p>Frontend engineer with 8+ years of building fast, accessible web apps in React and TypeScript. Led design-system and performance work for products with 2M+ monthly users, and comfortable across the stack with Node.js and PostgreSQL.</p>", "title": "Senior Frontend Engineer", "website": "jordanrivera.example.com"},
  "sections": [
   {"id": "experience", "items": [{"bullets": [], "company": "Northwind Traders", "current": true, "description": "<ul><li>Led the rebuild of the checkout flow in React and TypeScript, cutting drop-off by 18% and page weight by 40%.</li><li>Built the company design system — 60+ components with Storybook docs and visual regression tests — now used by six product teams.</li><li>Brought Largest Contentful Paint from 3.9 s to 1.6 s with route-level code splitting, an image CDN and server rendering.</li><li>Mentor four engineers and run the frontend guild's monthly architecture review.</li></ul>", "endDate": "", "id": "exp1", "location": "Austin, TX", "role": "Senior Frontend Engineer", "startDate": "03/2022"}, {"bullets": [], "company": "Contoso Bank", "current": false, "description": "<ul><li>Shipped the customer dashboard used by 2M+ people a month, from prototype to general availability.</li><li>Introduced end-to-end tests with Cypress; production incidents after releases fell by a third.</li><li>Made every customer-facing form meet WCAG 2.1 AA together with the accessibility team.</li></ul>", "endDate": "02/2022", "id": "exp2", "location": "Remote", "role": "Frontend Engineer", "startDate": "06/2019"}, {"bullets": [], "company": "Fabrikam Studio", "current": false, "description": "<ul><li>Built 20+ marketing sites and storefronts for retail clients.</li><li>Replaced a jQuery codebase with reusable React components, halving the time to deliver a new page.</li></ul>", "endDate": "05/2019", "id": "exp3", "location": "Dallas, TX", "role": "Web Developer", "startDate": "07/2017"}], "settings": {"columns": 1, "showDates": true, "showLocation": true, "spacing": "normal", "titleStyle": "stacked"}, "title": "Professional Experience", "type": "experience", "visible": true},
   {"id": "skills", "items": [{"category": "Languages", "id": "sk1", "skills": "TypeScript, JavaScript, HTML, CSS, SQL"}, {"category": "Frontend", "id": "sk2", "skills": "React, Next.js, Redux Toolkit, TanStack Query, Tailwind CSS, Storybook"}, {"category": "Backend", "id": "sk3", "skills": "Node.js, Express, PostgreSQL, REST, GraphQL"}, {"category": "Tooling", "id": "sk4", "skills": "Vite, Cypress, Jest, GitHub Actions, Docker, Figma"}], "settings": {"columns": 1, "separator": "colon", "skillsStyle": "inline", "spacing": "normal", "titleStyle": "inline"}, "title": "Skills", "type": "skills", "visible": true},
