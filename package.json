{
  "name": "flowcv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test \"tests/pdf/**/*.test.mjs\" \"tests/unit/*.unit.mjs\"",
    "test:pdf": "node --test \"tests/pdf/**/*.test.mjs\"",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --e2e",
    "test:unit": "node --test tests/unit/*.unit.mjs",
    "test:pw": "vite build --mode production && playwright test",
    "test:e2e": "vite build --mode e2e && start-server-and-test \"vite preview --host 127.0.0.1 --port 4173 --strictPort\" http://127.0.0.1:4173 \"cypress run --e2e\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/noto-sans": "^5.2.10",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/vite": "^4.3.1",
    "docx": "^9.7.1",
    "file-saver": "^2.0.5",
    "firebase": "^12.15.0",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "cypress": "14.5.4",
    "oxlint": "^1.69.0",
    "playwright": "^1.61.1",
    "start-server-and-test": "^3.0.12",
    "vite": "^8.1.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.4": true
  },
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@react-pdf/textkit@npm:^6.3.0": "patch:@react-pdf/textkit@npm%3A6.3.0#~/.yarn/patches/@react-pdf-textkit-npm-6.3.0-1e829976be.patch"
  }
}
